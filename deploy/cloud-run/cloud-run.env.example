# Copy to cloud-run.env locally or in Cloud Shell. Do not commit cloud-run.env.
# TiDB "Connect" screen values. Do not include the password here.
TIDB_HOST=gateway01.example.tidbcloud.com
TIDB_PORT=4000
TIDB_USERNAME=replace-me

# The globally unique bucket created by bootstrap-cloud-run.sh.
GCS_BUCKET=cheche-mvp-inspection-photos

# Public URL of the deployed frontend. The Gateway currently permits all origins for MVP,
# but keep this value for the production CORS tightening step.
FRONTEND_ORIGIN=https://your-frontend.example.com
