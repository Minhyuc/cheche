# Copy this file to .env. Do not commit the real .env file.
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Must be at least 32 bytes in production.
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRATION_SECONDS=3600

# Optional first superuser bootstrap.
CHECHE_SUPER_USER_ID=
CHECHE_SUPER_USER_NAME=CheChe Super User
CHECHE_SUPER_USER_EMAIL=superuser@example.com

# Optional service address overrides.
LOGIN_SERVICE_URI=http://localhost:8081
ADMIN_SERVICE_URI=http://localhost:8082
FACILITY_SERVICE_URI=http://localhost:8083
INSPECTION_SERVICE_URI=http://localhost:8084
